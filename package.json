{
  "name": "weaver",
  "version": "0.3.0",
  "description": "Time-stamped, depth-aware dimensions for Obsidian.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "node scripts/deploy.mjs"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "headings",
    "timestamps"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "26.1.2",
    "esbuild": "0.28.1",
    "obsidian": "1.13.1",
    "typescript": "7.0.2",
    "vitest": "4.1.0"
  }
}
