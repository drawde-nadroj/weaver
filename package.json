{
  "name": "weaver",
  "version": "0.5.0",
  "description": "Time-stamped, depth-aware dimensions for Obsidian.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bend:build": "$HOME/.bend/bin/bend src/core/duration.bend -o src/core/bend/duration.mjs",
    "bend:proof": "$HOME/.bend/bin/bend PROOF.bend && PATH=\"$HOME/.elan/bin:$PATH\" $HOME/.bend/bin/bend PROOF.bend --verdict",
    "design": "node scripts/design-index.mjs && node scripts/design-md.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:claims": "node scripts/docs-claims.mjs",
    "docs:falsify": "node scripts/docs-falsify.mjs",
    "check": "npm run typecheck && npm test && npm run bend:proof && npm run docs:check && npm run build",
    "deploy": "node scripts/deploy.mjs"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "entries",
    "timestamps"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "6.10.0",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "26.1.2",
    "esbuild": "0.28.1",
    "obsidian": "1.13.1",
    "typescript": "7.0.2",
    "vitest": "4.1.0"
  }
}
